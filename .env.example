# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored, so your key never ends up on GitHub.

# Required for the AI features (Memory, Ask 6ix, Discover).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Phase 2 (not used yet): Supabase project settings.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never prefix with NEXT_PUBLIC_
